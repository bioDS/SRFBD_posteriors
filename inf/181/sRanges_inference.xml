<beast version='2.0'
       namespace='beast.pkgmgmt
       :beast.base.core
       :beast.base.inference
       :beast.base.evolution.tree.coalescent
       :beast.base.evolution.sitemodel
       :beast.base.evolution.tree
       :beast.pkgmgmt
       :beast.base.core
       :beast.base.inference.util:beast.evolution.nuc:beast.base.evolution.operator:beast.base.inference.operator:beast.base.evolution.sitemodel:beast.base.evolution.substitutionmodel:beast.base.evolution.likelihood:beast.base.evolution.alignment
       :sr.evolution.operators
       :sa.evolution.operators
       :sr.evolution.tree
       :sr.evolution.sranges
       :sr.speciation
       :feast.parameter
       :ssr.speciation'>


    <map name="Uniform">beast.base.inference.distribution.Uniform</map>
    <map name="Exponential">beast.base.inference.distribution.Exponential</map>
    <map name="LogNormal">beast.base.inference.distribution.LogNormalDistributionModel</map>
    <map name="Normal">beast.base.inference.distribution.Normal</map>
    <map name="Beta">beast.base.inference.distribution.Beta</map>
    <map name="Gamma">beast.base.inference.distribution.Gamma</map>
    <map name="LaplaceDistribution">beast.base.inference.distribution.LaplaceDistribution</map>
    <map name="prior">beast.base.inference.distribution.Prior</map>
    <map name="InverseGamma">beast.base.inference.distribution.InverseGamma</map>
    <map name="OneOnX">beast.base.inference.distribution.OneOnX</map>


    <run spec="MCMC" id="mcmc" chainLength="10000000">

        <state id="state" storeEvery="100">
            <tree id="tree" spec="sr.evolution.tree.SRTree" nodetype="sr.evolution.tree.SRNode" name="stateNode">
                <trait id="dateTrait.t:tree" spec="beast.base.evolution.tree.TraitSet" traitname="date-backward">
                    <taxa spec="TaxonSet" id="taxonSet">
                        <taxon spec='Taxon' id='t39_first'/>
						<taxon spec='Taxon' id='t48_first'/>
						<taxon spec='Taxon' id='t10_first'/>
						<taxon spec='Taxon' id='t8_first'/>
						<taxon spec='Taxon' id='t44_first'/>
						<taxon spec='Taxon' id='t46_first'/>
						<taxon spec='Taxon' id='t25_first'/>
						<taxon spec='Taxon' id='t12_first'/>
						<taxon spec='Taxon' id='t33_first'/>
						<taxon spec='Taxon' id='t4_first'/>
						<taxon spec='Taxon' id='t34_first'/>
						<taxon spec='Taxon' id='t17_first'/>
						<taxon spec='Taxon' id='t2_first'/>
						<taxon spec='Taxon' id='t49_first'/>
						<taxon spec='Taxon' id='t18_first'/>
						<taxon spec='Taxon' id='t14_first'/>
						<taxon spec='Taxon' id='t27_first'/>
						<taxon spec='Taxon' id='t24_first'/>
						<taxon spec='Taxon' id='t6_first'/>
						<taxon spec='Taxon' id='t35_first'/>
						<taxon spec='Taxon' id='t38_first'/>
						<taxon spec='Taxon' id='t40_first'/>
						<taxon spec='Taxon' id='t23_first'/>
                    </taxa>
                    t39_first=1.28476228942451, t48_first=0, t10_first=0.336916929478065, t8_first=0, t44_first=0, t46_first=0, t25_first=0, t12_first=0, t33_first=0, t4_first=0, t34_first=0, t17_first=0, t2_first=0, t49_first=0, t18_first=0, t14_first=0.663494324943152, t27_first=1.14974632810997, t24_first=0, t6_first=0, t35_first=0, t38_first=0, t40_first=1.20951565675739, t23_first=2.82531619979129
                </trait>
                <taxonset idref="taxonSet" />
                <stratigraphicRange id="r0" spec="StratigraphicRange" firstOccurrence="@t39_first" lastOccurrence="@t39_first"/>
				<stratigraphicRange id="r1" spec="StratigraphicRange" firstOccurrence="@t48_first" lastOccurrence="@t48_first"/>
				<stratigraphicRange id="r2" spec="StratigraphicRange" firstOccurrence="@t10_first" lastOccurrence="@t10_first"/>
				<stratigraphicRange id="r3" spec="StratigraphicRange" firstOccurrence="@t8_first" lastOccurrence="@t8_first"/>
				<stratigraphicRange id="r4" spec="StratigraphicRange" firstOccurrence="@t44_first" lastOccurrence="@t44_first"/>
				<stratigraphicRange id="r5" spec="StratigraphicRange" firstOccurrence="@t46_first" lastOccurrence="@t46_first"/>
				<stratigraphicRange id="r6" spec="StratigraphicRange" firstOccurrence="@t25_first" lastOccurrence="@t25_first"/>
				<stratigraphicRange id="r7" spec="StratigraphicRange" firstOccurrence="@t12_first" lastOccurrence="@t12_first"/>
				<stratigraphicRange id="r8" spec="StratigraphicRange" firstOccurrence="@t33_first" lastOccurrence="@t33_first"/>
				<stratigraphicRange id="r9" spec="StratigraphicRange" firstOccurrence="@t4_first" lastOccurrence="@t4_first"/>
				<stratigraphicRange id="r10" spec="StratigraphicRange" firstOccurrence="@t34_first" lastOccurrence="@t34_first"/>
				<stratigraphicRange id="r11" spec="StratigraphicRange" firstOccurrence="@t17_first" lastOccurrence="@t17_first"/>
				<stratigraphicRange id="r12" spec="StratigraphicRange" firstOccurrence="@t2_first" lastOccurrence="@t2_first"/>
				<stratigraphicRange id="r13" spec="StratigraphicRange" firstOccurrence="@t49_first" lastOccurrence="@t49_first"/>
				<stratigraphicRange id="r14" spec="StratigraphicRange" firstOccurrence="@t18_first" lastOccurrence="@t18_first"/>
				<stratigraphicRange id="r15" spec="StratigraphicRange" firstOccurrence="@t14_first" lastOccurrence="@t14_first"/>
				<stratigraphicRange id="r16" spec="StratigraphicRange" firstOccurrence="@t27_first" lastOccurrence="@t27_first"/>
				<stratigraphicRange id="r17" spec="StratigraphicRange" firstOccurrence="@t24_first" lastOccurrence="@t24_first"/>
				<stratigraphicRange id="r18" spec="StratigraphicRange" firstOccurrence="@t6_first" lastOccurrence="@t6_first"/>
				<stratigraphicRange id="r19" spec="StratigraphicRange" firstOccurrence="@t35_first" lastOccurrence="@t35_first"/>
				<stratigraphicRange id="r20" spec="StratigraphicRange" firstOccurrence="@t38_first" lastOccurrence="@t38_first"/>
				<stratigraphicRange id="r21" spec="StratigraphicRange" firstOccurrence="@t40_first" lastOccurrence="@t40_first"/>
				<stratigraphicRange id="r22" spec="StratigraphicRange" firstOccurrence="@t23_first" lastOccurrence="@t23_first"/>
            </tree>
            <parameter id='origin' lower='0.0'
                                name='stateNode'>162.073529633961</parameter>
            <parameter id='netDiversification' lower='0.0'
                                name='stateNode'>0.712171644344926</parameter>
            <parameter id='turnOver' lower='0.' upper = '1.'
                                name='stateNode'>0.363595245778561</parameter>
            <parameter id='samplingProportion' lower='0.0'
                                name='stateNode'>0.771083139674738</parameter>
            <parameter id='rho' lower='0.0'
                                name='stateNode'>0.926033109519631</parameter>
        </state>

        <init estimate="false" id="Randomtree" initial="@tree" spec="RandomSRangeTree" nodetype="sr.evolution.tree.SRNode" taxonset="@taxonSet">
            <populationModel id="ConstantPopulation0.t" spec="ConstantPopulation">
                <parameter id="randomPopSize.t" name="popSize">1.0</parameter>
            </populationModel>
            <stratigraphicRange idref="r0"/>
			<stratigraphicRange idref="r1"/>
			<stratigraphicRange idref="r2"/>
			<stratigraphicRange idref="r3"/>
			<stratigraphicRange idref="r4"/>
			<stratigraphicRange idref="r5"/>
			<stratigraphicRange idref="r6"/>
			<stratigraphicRange idref="r7"/>
			<stratigraphicRange idref="r8"/>
			<stratigraphicRange idref="r9"/>
			<stratigraphicRange idref="r10"/>
			<stratigraphicRange idref="r11"/>
			<stratigraphicRange idref="r12"/>
			<stratigraphicRange idref="r13"/>
			<stratigraphicRange idref="r14"/>
			<stratigraphicRange idref="r15"/>
			<stratigraphicRange idref="r16"/>
			<stratigraphicRange idref="r17"/>
			<stratigraphicRange idref="r18"/>
			<stratigraphicRange idref="r19"/>
			<stratigraphicRange idref="r20"/>
			<stratigraphicRange idref="r21"/>
			<stratigraphicRange idref="r22"/>
        </init>

        <init id="netDiversificationInitializer" spec="feast.parameter.RandomRealParameter"
              initial="@netDiversification" distr="@Uniform.div">
        </init>
        <init id="turnoverInitializer" spec="feast.parameter.RandomRealParameter"
              initial="@turnOver" distr="@Uniform.turnover">
        </init>
        <init id="samplingProportionInitializer" spec="feast.parameter.RandomRealParameter"
              initial="@samplingProportion" distr="@Uniform.samplingProportion">
        </init>

        <distribution id="posterior" spec="CompoundDistribution">
            <distribution id="prior" spec="CompoundDistribution">
                <distribution spec="SRangesBirthDeathSkylineModel" id="birthDeath" tree="@tree" conditionOnSurvival="true" removalProbability="0.0" intervalTimes="0">
                    <origin idref="origin"/>
                    <netDiversification idref="netDiversification"/>
                    <turnOver idref="turnOver"/>
                    <samplingProportion idref="samplingProportion"/>
                    <rho idref="rho"/>
                </distribution>
                <prior id="originPrior" name="distribution" x="@origin">
                    <Uniform id="Uniform.origin" name="distr" lower="1" upper="1000"/>
                </prior>
                <prior id="netDiversificationPrior" name="distribution" x="@netDiversification">
                    <Uniform id="Uniform.div" name="distr" lower="0.7" upper="0.9" offset="0."/>
                </prior>
                <prior id="turnoverPrior" name="distribution" x="@turnOver">
                    <Uniform id="Uniform.turnover" name="distr" lower="0.2" upper="0.8" offset="0."/>
                </prior>
                <prior id="samplingProportionPrior" name="distribution" x="@samplingProportion">
                    <Uniform id="Uniform.samplingProportion" name="distr" lower="0.2" upper="0.8" offset="0."/>
                </prior>
                <prior id="rhoPrior" name="distribution" x="@rho">
                    <Uniform id="Uniform.rho" lower="0.7" upper="1." name="distr"/>
                </prior>

            </distribution>

        </distribution>


<!--        Parameter operators -->
        <operator id="originScaler" parameter="@origin" scaleFactor="0.75" spec="ScaleOperator" weight="1.0"/>
        <operator id='netDiversificatonOperator' spec='ScaleOperator' scaleFactor=".75" weight="5" parameter="@netDiversification"/>
        <operator id='turnOverOperator' spec='ScaleOperator' scaleFactor=".75" weight="5" parameter="@turnOver"/>
        <operator id='samplingProportionOperator' spec='ScaleOperator' scaleFactor=".75" weight="5" parameter="@samplingProportion"/>
        <operator id='rhoOperator' spec='ScaleOperator' scaleFactor=".75" weight="5" parameter="@rho"/>

<!--        Tree operators -->
        <operator id="SRWilsonBalding" spec='SRWilsonBalding' weight="20" tree="@tree"/>
        <operator id="LeftRightChildSwap" spec='LeftRightChildSwap' weight="5" tree="@tree"/>
        <operator id="LeafToSampledAncestorJump" spec='SRLeafToSampledAncestorJump' weight="20" tree="@tree" />
        <operator spec="SAUniform" weight="20" tree="@tree"/>
        <operator id="SATreeRootScaler" rootOnly="true" scaleFactor="0.56" spec="SAScaleOperator" tree="@tree" weight="3.0" />
        <operator id='treeScaler' spec="SAScaleOperator" scaleFactor="0.16" weight="10.0" tree="@tree"/>


        <logger logEvery="5000" fileName="sRanges.$(seed).log">
            <model idref='posterior'/>

            <log id="TreeHeight" spec="TreeHeightLogger" tree="@tree"/>
            <log idref="origin"/>
            <log idref="netDiversification"/>
            <log idref="turnOver"/>
            <log idref="samplingProportion"/>
            <log idref="rho"/>
            <log idref="posterior"/>
        </logger>
        <logger logEvery="5000" fileName="sRanges.$(seed).trees">
        <log idref="tree"/>
        </logger>
    </run>
        
        
        </beast>
