			<stratigraphicRange idref="r64"/>
			<stratigraphicRange idref="r65"/>
			<stratigraphicRange idref="r66"/>
			<stratigraphicRange idref="r67"/>
			<stratigraphicRange idref="r68"/>
			<stratigraphicRange idref="r69"/>
